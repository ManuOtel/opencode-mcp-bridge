# Copy to .env and fill in. Never commit .env.
# Opencode server (Basic auth, same values as /etc/opencode-server/env)
OPENCODE_BASE_URL=http://10.0.1.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me
# Bearer token ChatGPT sends as: Authorization: Bearer <token>
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_BEARER_TOKEN=change-me
# Bridge listen address
MCP_HOST=0.0.0.0
MCP_PORT=8087
# Default working directory for opencode sessions when ChatGPT omits it
DEFAULT_DIRECTORY=/home/manuotel
# Caps for the exec_run tool
EXEC_TIMEOUT_S=120
EXEC_MAX_OUTPUT_CHARS=20000
