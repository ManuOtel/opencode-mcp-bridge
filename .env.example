# Copy to .env and fill in. Never commit .env.
# Opencode server (Basic auth, same credentials your opencode serve/web uses)
OPENCODE_BASE_URL=http://127.0.0.1:4096
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=change-me
# Bearer token MCP clients send as: Authorization: Bearer <token>
# Generate with: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
MCP_BEARER_TOKEN=change-me
# Optional secondary token for zero-downtime rotation. Unset by default
# (single-token mode). Rotation: 1) generate a new token, 2) set it here
# as MCP_BEARER_TOKEN_SECONDARY, 3) restart/reload the bridge and move
# clients over, 4) promote it to MCP_BEARER_TOKEN, unset the secondary,
# restart. Blank or duplicate values fail startup closed. Never commit .env.
# MCP_BEARER_TOKEN_SECONDARY=
# Bridge listen address. 127.0.0.1 for local runs. When a reverse proxy in
# Docker must reach the bridge, use a host IP on the shared docker network
# instead (127.0.0.1 would be the proxy container itself).
MCP_HOST=127.0.0.1
MCP_PORT=8087
# Default working directory for opencode sessions when clients omit it.
# Falls back to $HOME when unset.
# DEFAULT_DIRECTORY=/home/user
# Default model for send_message when no provider/model override is supplied.
# DEFAULT_PROVIDER_ID=opencode
# DEFAULT_MODEL_ID=muse-spark-1.3-contributor-free
# Caps for the exec_run tool
EXEC_TIMEOUT_S=120
EXEC_MAX_OUTPUT_CHARS=20000
# Raw shell gate: exec_run on /mcp stays listed but fails closed unless true.
# New installs default to false (safe). Set true only where a shell is intended.
# Production hosts that need legacy shell compatibility set ENABLE_EXEC_RUN=true
# in the deployment env file (0600). /worker-mcp never exposes exec_run.
# ENABLE_EXEC_RUN=false
# Durable task registry for idempotent worker_run (JSON, no prompts or secrets).
# TASK_STATE_PATH=/var/lib/opencode-mcp-bridge/tasks.json
# Stale worker timeout (seconds): a task still running with empty output past
# this limit reports state=stale with a bounded reason and recovery hint.
# Default 600, must be between 60 and 3600. Legacy records without timestamps
# never classify stale.
# TASK_STALE_AFTER_S=600
# Max request body (bytes) for /mcp and /worker-mcp. Default 1048576
# (1 MiB). Oversized declared Content-Length returns generic 413 before any
# tool runs. Absent, malformed, or under-declared lengths are still enforced
# on streamed/chunked bytes with bounded coalesced buffering. Must be > 0.
# MCP_MAX_BODY_BYTES=1048576
# Optional browser-origin allowlist for /mcp and /worker-mcp. Unset or blank
# means no origin policy (CLI/SDK clients send no Origin and keep working).
# When set, use comma-separated exact origins "scheme://host[:port]" with an
# http/https scheme and no path, query, or fragment. A single trailing slash
# is stripped. A present Origin must match exactly; when Origin is absent, a
# present Referer must derive to an allowed origin, and malformed Referer
# values are rejected with generic 403 after auth. Auth still runs first, so
# missing tokens stay 401. /health never checks origins. Malformed entries
# fail startup closed. Never inferred from Host or request URL.
# MCP_ALLOWED_ORIGINS=https://app.example,https://admin.example
